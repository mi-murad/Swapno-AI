# Local Supabase values are shown by `npm run supabase:start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_local_value
API_PORT=3001
WEB_ORIGINS=http://127.0.0.1:5173
NODE_ENV=development

# Optional local AI gateway. Keep credentials server-side; never use VITE_ prefixes.
# For 9Router running on this same PC:
# AI_BASE_URL=http://127.0.0.1:20128/v1
# AI_API_KEY=your_private_9router_key
# AI_DEFAULT_MODEL=exact-model-id-from-v1-models
# AI_REQUEST_TIMEOUT_MS=45000
