{
  "name": "@swapno/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "start": "node dist/server.js",
    "test": "vitest run src",
    "test:security": "vitest run src/app.test.ts -t \"API authentication and request boundaries\""
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@supabase/supabase-js": "2.119.0",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "5.1.0"
  }
}
